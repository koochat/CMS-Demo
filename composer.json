{
    "name": "mol-cms/demo",
    "description": "Personal learning CMS demo built with PHP without a full-stack framework.",
    "type": "project",
    "require": {
        "php": "8.5.*",
        "twig/twig": "^3.29"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}